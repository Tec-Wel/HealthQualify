---
import BaseLayout from '../../layouts/BaseLayout.astro';
const root = import.meta.env.BASE_URL;
const steps = [
  {
    label: '01 / Define',
    heading: 'Begin with an explicit requirement',
    detail: 'A fictional laboratory information system contains seven documented, synthetic requirements. A versioned DRAFT protocol links each requirement to predefined qualification checks.',
    status: 'DRAFT PROTOCOL',
    rows: [['REQ-01','Patient-free sample accession ID','Covered'],['REQ-02','Synthetic validation limit','Covered'],['REQ-03','Synthetic interface response','Covered']]
  },
  {
    label: '02 / Execute',
    heading: 'Run deterministic synthetic checks',
    detail: 'The known demonstration fixture intentionally produces two passes and five failures. The result is generated by the deterministic execution path, not by an AI model.',
    status: '2 PASS / 5 SEEDED FAIL',
    rows: [['TEST-01','Synthetic accession logic','PASS'],['TEST-02','Missing-value handling','FAIL'],['TEST-03','Format validation','FAIL']]
  },
  {
    label: '03 / Investigate',
    heading: 'Ask an advisory agent about a gap',
    detail: 'The Gap Hunter reviews a bounded synthetic evidence snapshot and drafts questions about incomplete or failed coverage. Its suggestions are not independent test results.',
    status: 'ADVISORY DRAFT',
    rows: [['GAP-01','Failed synthetic criterion','Investigate'],['GAP-02','Evidence provenance','Review'],['GAP-03','Traceability impact','Review']]
  },
  {
    label: '04 / Review',
    heading: 'Keep human QA in control',
    detail: 'A separate QA reviewer can acknowledge or request further investigation. No acknowledgment is a regulated electronic signature or release approval.',
    status: 'NOT APPROVED',
    rows: [['REVIEW-01','Independent QA disposition','Pending'],['SYSTEM','Regulated qualification','Not approved'],['EVIDENCE','Synthetic developer alpha','Draft']]
  }
];
---
<BaseLayout title="Interactive synthetic product tour" description="Explore a guided synthetic HealthQualify walkthrough without installing software. A static illustration, not live test execution.">
  <section class="page-hero"><div class="container"><div class="eyebrow"><span class="live-dot"></span> EXPLORE WITHOUT INSTALLING</div><h1>Follow the evidence.<br/><em>Understand every decision.</em></h1><p class="lead">Explore the HealthQualify qualification journey using a browser-only, fictional demonstration. This tour does not run tests, log in, send data, or contact an AI model.</p><div class="cta-row"><a class="button primary" href="#tour">Start the tour ↓</a><a class="button ghost" href={root+'docs/END_TO_END_WORKFLOW/'}>Full technical workflow ↗</a></div></div></section>
  <section class="section light" id="tour"><div class="container">
    <div class="tour-heading"><div><span class="kicker">GUIDED WALKTHROUGH</span><h2>Four steps. One evidence trail.</h2></div><span class="demo-note">STATIC ILLUSTRATION · NO LIVE EXECUTION</span></div>
    <div class="tour-layout">
      <div class="tour-nav" aria-label="Synthetic qualification tour steps">
        {steps.map((s,i) => <button type="button" class="tour-step" data-tour-step={i} aria-current={i === 0 ? 'step' : undefined}><span>{s.label}</span><strong>{s.heading}</strong></button>)}
      </div>
      <div class="tour-stage" role="region" aria-labelledby="tour-title">
        <div class="tour-stage-head"><span>HEALTHQUALIFY · SYNTHETIC TOUR</span><span id="tour-state" class="alpha-pill">{steps[0].status}</span></div>
        <div class="tour-stage-body">
          <span class="kicker" id="tour-count">STEP 01 OF 04</span>
          <h3 id="tour-title" tabindex="-1">{steps[0].heading}</h3>
          <p id="tour-description">{steps[0].detail}</p>
          <div class="tour-table-wrap"><table class="tour-table"><thead><tr><th>Reference</th><th>Details</th><th>State</th></tr></thead><tbody id="tour-rows">{steps[0].rows.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div>
          <div class="tour-controls"><button type="button" class="button outline" id="tour-prev" disabled>← Previous</button><button type="button" class="button dark" id="tour-next">Next step →</button></div>
        </div>
      </div>
    </div>
    <div class="notice-panel"><strong>Important distinction:</strong> These are authored illustrative states based on the documented synthetic scenario—not screenshots, actual run results or certification claims. To execute the real software, use the local developer-alpha application.</div>
    <div class="cta-row"><a href={root+'local-edition/'} class="button primary">Run HealthQualify locally ↗</a><a href={root+'architecture/'} class="button outline">Explore the architecture →</a></div>
  </div></section>
  <script define:vars={{steps}}>
    const buttons=[...document.querySelectorAll('[data-tour-step]')];
    let current=0;
    const heading=document.getElementById('tour-title');
    const desc=document.getElementById('tour-description');
    const table=document.getElementById('tour-rows');
    function render(i) {
      current=Math.max(0,Math.min(steps.length-1,i));
      const s=steps[current];
      document.getElementById('tour-count').textContent='STEP '+String(current+1).padStart(2,'0')+' OF 04';
      document.getElementById('tour-state').textContent=s.status;
      heading.textContent=s.heading;
      desc.textContent=s.detail;
      table.replaceChildren();
      for(const values of s.rows){
        const tr=document.createElement('tr');
        for(const v of values){const td=document.createElement('td');td.textContent=v;tr.append(td);}
        table.append(tr);
      }
      buttons.forEach((b,j)=>j===current?b.setAttribute('aria-current','step'):b.removeAttribute('aria-current'));
      document.getElementById('tour-prev').disabled=current===0;
      document.getElementById('tour-next').textContent=current===steps.length-1?'Restart tour ↺':'Next step →';
    }
    buttons.forEach((b,i)=>b.addEventListener('click',()=>{render(i);heading.focus();}));
    document.getElementById('tour-prev').addEventListener('click',()=>{render(current-1);heading.focus();});
    document.getElementById('tour-next').addEventListener('click',()=>{render(current===steps.length-1?0:current+1);heading.focus();});
  </script>
</BaseLayout>
