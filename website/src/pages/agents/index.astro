---
import BaseLayout from '../../layouts/BaseLayout.astro';
const root=import.meta.env.BASE_URL;
const data=[
['release-impact','01','Release Impact Investigator','Correlates changed source paths with mapped qualification tests and indicates unknown impact when dependencies are missing.'],
['gap-hunter','02','Qualification Gap Hunter','Identifies uncovered requirements, missing test links and missing independently verified technical evidence.'],
['failure-investigation','03','Failure Investigation Copilot','Investigates repeated failures, recent regressions and unresolved deviations using scoped run history.'],
['qa-readiness','04','QA Evidence Readiness','Highlights evidence questions and review blockers. No agent can approve a protocol or release.'],
['dependency-investigator','05','Cross-System Dependency Investigator','Surfaces possible downstream dependencies and unknown mappings when components change.']
];
---
<BaseLayout title="Five advisory AI investigators" description="Explore five source-linked deterministic qualification investigators, optionally supported by local Qwen. Synthetic-only developer alpha." active="agents">
<section class="page-hero"><div class="container"><div class="eyebrow"><span class="live-dot"></span> QUALIFICATION INTELLIGENCE</div><h1>Five investigators.<br/><em>One source of truth.</em></h1><p class="lead">Scoped analysis and human review, without giving a language model authority to change deterministic evidence.</p><div class="cta-row"><a class="button primary" href={root+'docs/AI_AGENTS_GUIDE/'}>Agent documentation ↗</a><a class="button ghost" href={root+'local-edition/'}>Run locally →</a></div></div></section>
<section class="section light"><div class="container"><div class="agent-detail-grid">{data.map(([id,n,title,description])=><article id={id} class="detail-card"><span class="kicker">{n} / AGENT</span><h2>{title}</h2><p>{description}</p><div class="detail-meta">READ-ONLY EVIDENCE · ADVISORY DRAFT · HUMAN QA REVIEW</div></article>)}</div></div></section>
<section class="section pale"><div class="container compact"><span class="kicker">PRIVACY BY DEFAULT</span><h2>Optional Qwen. Never mandatory.</h2><p>The five deterministic investigators run without any LLM. A user may separately enable Ollama/Qwen for unverified narrative explanation, subject to local-model testing and controls.</p><a class="text-link" href={root+'docs/AGENT_RUNTIME_V07/'}>Read runtime and validation limits ↗</a></div></section>
</BaseLayout>
